# =============================================================================
# Приклад змінних середовища.
# Скопіюйте у файл .env і підставте власні значення:
#     cp .env.example .env
# Справжній .env у git не потрапляє (див. .gitignore).
# =============================================================================

# --- PostgreSQL (використовується сервісом db у docker-compose) ---
POSTGRES_USER=courier
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=courier_db
POSTGRES_PORT=5432

# --- Backend ---
# У Docker Compose хостом бази є ім'я сервісу "db".
# Для запуску без Docker замініть db на localhost.
DATABASE_URL=postgresql+psycopg://courier:change-me-locally@db:5432/courier_db

# Ключ підпису JWT. Згенеруйте власний, наприклад:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ENVIRONMENT=development
DEBUG=false
BACKEND_PORT=8000

# Дозволені origin для CORS, через кому.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Тестові дані (використовує scripts/seed.py) ---
SEED_ADMIN_EMAIL=admin@courier.ua
SEED_DEFAULT_PASSWORD=Password123!

# --- Frontend ---
# Адреса backend, яку використовує браузер.
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173

# --- Тести backend ---
# Окрема база, яка очищується під час тестів.
TEST_DATABASE_URL=postgresql+psycopg://courier:change-me-locally@localhost:5432/courier_test
